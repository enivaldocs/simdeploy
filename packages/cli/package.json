{
  "name": "simdeploy",
  "version": "0.1.0",
  "private": true,
  "description": "SimDeploy CLI — deploy sem escolher infraestrutura",
  "type": "module",
  "bin": {
    "simdeploy": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@simdeploy/build-engine": "workspace:*",
