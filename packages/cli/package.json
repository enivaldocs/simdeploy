{
  "name": "autocloud",
  "version": "0.1.0",
  "private": true,
  "description": "AutoCloud CLI — deploy sem escolher infraestrutura",
  "type": "module",
  "bin": {
    "autocloud": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
