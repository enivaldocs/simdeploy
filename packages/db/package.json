{
  "name": "@simdeploy/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@simdeploy/shared": "workspace:*",
    "@prisma/client": "^6.16.0"
  },
  "devDependencies": {
    "@simdeploy/cost-engine": "workspace:*",
    "@types/node": "^22.18.0",
    "dotenv-cli": "^10.0.0",
    "prisma": "^6.16.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  }
}
