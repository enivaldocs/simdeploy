generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Identidade e multi-tenancy
// ============================================================

/// Papel de STAFF da AutoCloud (admin interno) — não confundir com MemberRole (papel dentro de uma organização cliente)
enum StaffRole {
  NONE
  SUPPORT
  FINANCE
  OPERATIONS
  ADMIN
  SUPER_ADMIN
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  staffRole   StaffRole @default(NONE)
  name        String?
  githubId    String?  @unique
  githubLogin String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships OrganizationMember[]
  sessions    Session[]
  apiTokens   ApiToken[]
  auditLogs   AuditLog[]
  acquisition Acquisition?
}

model Session {
  id        String   @id @default(cuid())
  /// SHA-256 do token de sessão (o token em claro vive só no cookie)
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members         OrganizationMember[]
  projects        Project[]
  apiTokens       ApiToken[]
  auditLogs       AuditLog[]
  subscription    Subscription?
  analyticsEvents AnalyticsEvent[]
  payments        Payment[]
  invoices        Invoice[]
  creditEntries   CreditLedgerEntry[]
  providerCosts   ProviderCost[]
  notifications   Notification[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           MemberRole   @default(MEMBER)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

// ============================================================
// Projetos e deployments
// ============================================================

model Project {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  /// Slug global: vira o subdomínio <slug>.autocloud.app (e o path do provider local)
  slug           String       @unique
  framework      String?
  gitRepoUrl     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  environments    Environment[]
  deployments     Deployment[]
  domains         Domain[]
  envVars         EnvironmentVariable[]
  usageMetrics    UsageMetric[]
  costEstimates   CostEstimate[]
  recommendations OptimizationRecommendation[]
  providerCosts   ProviderCost[]

  @@index([organizationId])
}

model Environment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// "production" | "preview"
  name      String
  createdAt DateTime @default(now())

  deployments Deployment[]
  envVars     EnvironmentVariable[]

  @@unique([projectId, name])
}

enum DeploymentStatus {
  CREATED
  ANALYZING
  QUEUED
  BUILDING
  UPLOADING
  DEPLOYING
  HEALTH_CHECK
  READY
  ANALYSIS_FAILED
  BUILD_FAILED
  DEPLOY_FAILED
  CANCELED
}

enum DeploymentTrigger {
  cli
  api
  dashboard
  git
}

model Deployment {
  id            String            @id @default(cuid())
  projectId     String
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environmentId String?
  environment   Environment?      @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  status        DeploymentStatus  @default(CREATED)
  trigger       DeploymentTrigger @default(cli)
  branch        String?
  commitSha     String?
  commitMessage String?
  /// ProjectAnalysis serializado (schemaVersion interno)
  analysis      Json?
  /// RoutingDecision do AICloudRouter
  plan          Json?
  /// URL pública após READY
  url           String?
  /// Mensagem de erro em estados *_FAILED
  error         String?
  /// Caminho/id do artefato recebido (storage interno)
  artifactRef   String?
  startedAt     DateTime          @default(now())
  finishedAt    DateTime?
  durationMs    Int?
  createdAt     DateTime          @default(now())

  events        DeploymentEvent[]
  logs          LogEntry[]
  costEstimates CostEstimate[]

  @@index([projectId, createdAt(sort: Desc)])
  @@index([status])
}

/// Evento de transição da máquina de estados (auditoria do pipeline)
model DeploymentEvent {
  id           String     @id @default(cuid())
  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  fromStatus   DeploymentStatus?
  toStatus     DeploymentStatus
  message      String?
  createdAt    DateTime   @default(now())

  @@index([deploymentId, createdAt])
}

enum LogLevel {
  debug
  info
  warn
  error
}

model LogEntry {
  id           String     @id @default(cuid())
  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  timestamp    DateTime   @default(now())
  /// ANALYZE | QUEUE | BUILD | DEPLOY | SYSTEM
  stage        String
  level        LogLevel   @default(info)
  message      String
  metadata     Json?

  @@index([deploymentId, timestamp])
}

// ============================================================
// Domínios
// ============================================================

enum DomainType {
  SUBDOMAIN
  CUSTOM
}

enum DomainStatus {
  PENDING
  VERIFYING
  ACTIVE
  ERROR
}

model Domain {
  id                String       @id @default(cuid())
  projectId         String
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hostname          String       @unique
  type              DomainType   @default(SUBDOMAIN)
  status            DomainStatus @default(PENDING)
  sslStatus         String?
  verificationToken String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([projectId])
}

// ============================================================
// Environment variables (valores sempre criptografados em repouso)
// ============================================================

model EnvironmentVariable {
  id             String       @id @default(cuid())
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environmentId  String?
  environment    Environment? @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  key            String
  /// AES-256-GCM (v1:iv:tag:ct) — nunca armazenar em claro
  valueEncrypted String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([projectId, environmentId, key])
  @@index([projectId])
}

// ============================================================
// Providers e pricing (configuração, nunca hardcoded na lógica)
// ============================================================

model Provider {
  id        String   @id @default(cuid())
  /// "local" | "cloudflare" | futuros
  slug      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  pricing ProviderPricing[]
}

model ProviderPricing {
  id            String   @id @default(cuid())
  providerId    String
  provider      Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  /// ResourceKind: requests | bandwidth_gb | storage_gb | build_minute | ...
  resource      String
  unit          String
  pricePerUnit  Decimal  @db.Decimal(18, 10)
  currency      String   @default("USD")
  freeAllowance Decimal  @default(0) @db.Decimal(18, 4)
  /// Arquiteturas às quais o item se aplica + metadados
  metadata      Json?
  /// Data do snapshot da tabela pública do provider
  effectiveAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([providerId, resource])
}

// ============================================================
// Uso, custo e otimização (Autopilot)
// ============================================================

model UsageMetric {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// requests | bandwidth_gb | storage_gb | build_minute | ...
  metric      String
  value       Decimal  @db.Decimal(18, 4)
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())

  @@index([projectId, metric, periodStart])
}

model CostEstimate {
  id           String      @id @default(cuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deploymentId String?
  deployment   Deployment? @relation(fields: [deploymentId], references: [id], onDelete: SetNull)
  provider     String
  architecture String
  monthlyUsd   Decimal     @db.Decimal(12, 4)
  currency     String      @default("USD")
  /// CostBreakdownLine[]
  breakdown    Json
  /// ExpectedUsage usado como premissa (projeção, não medição)
  assumptions  Json
  createdAt    DateTime    @default(now())

  @@index([projectId, createdAt(sort: Desc)])
}

enum RecommendationStatus {
  OPEN
  APPLIED
  DISMISSED
}

model OptimizationRecommendation {
  id               String               @id @default(cuid())
  projectId        String
  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  currentCostUsd   Decimal              @db.Decimal(12, 4)
  optimizedCostUsd Decimal              @db.Decimal(12, 4)
  savingPercent    Decimal              @db.Decimal(5, 2)
  /// Mudanças propostas (arquitetura/provider/recursos)
  changes          Json
  status           RecommendationStatus @default(OPEN)
  createdAt        DateTime             @default(now())
  resolvedAt       DateTime?

  @@index([projectId, status])
}

// ============================================================
// API tokens (auth programática: CLI, MCP, agentes)
// ============================================================

model ApiToken {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  /// SHA-256 do token; o token em claro é mostrado uma única vez
  tokenHash      String       @unique
  /// Prefixo exibível (ac_live_xxxxxx)
  displayPrefix  String
  /// TokenScope[]
  scopes         String[]
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// ============================================================
// Auditoria e analytics
// ============================================================

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Ex.: project.create, deployment.create, env.set, token.create
  action         String
  resourceType   String
  resourceId     String?
  /// Estado anterior/posterior para mudanças sensíveis (planos, créditos, permissões)
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt(sort: Desc)])
}

model AnalyticsEvent {
  id             String        @id @default(cuid())
  name           String
  userId         String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  properties     Json?
  createdAt      DateTime      @default(now())

  @@index([name, createdAt])
}

// ============================================================
// Billing (planos configuráveis; valores nunca hardcoded no código)
// ============================================================

model Plan {
  id         String   @id @default(cuid())
  /// free | pro | builder | agency
  slug       String   @unique
  name       String
  /// Dinheiro sempre em minor units (centavos) + currency — nunca float
  currency             String  @default("BRL")
  priceMonthlyMinor    Int     @default(0)
  priceAnnualMinor     Int?
  stripeProductId      String?
  stripePriceMonthlyId String?
  stripePriceAnnualId  String?
  /// Limites: { maxProjects, maxDeploymentsPerDay, customDomains, ... }
  limits     Json
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId               String
  plan                 Plan               @relation(fields: [planId], references: [id])
  status               SubscriptionStatus @default(ACTIVE)
  /// Preparação para Stripe — preenchidos quando billing real for integrado
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  canceledAt           DateTime?
  cancelReason         String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

// ============================================================
// Billing real: pagamentos, invoices, créditos (dinheiro SEMPRE em
// minor units + currency; nunca float, nunca somar moedas distintas)
// ============================================================

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id                    String        @id @default(cuid())
  organizationId        String
  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  amountMinor           Int
  currency              String
  status                PaymentStatus @default(PENDING)
  stripePaymentIntentId String?       @unique
  stripeChargeId        String?
  invoiceId             String?
  invoice               Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  description           String?
  createdAt             DateTime      @default(now())

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([status, createdAt])
}

model Invoice {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stripeInvoiceId String       @unique
  number          String?
  amountDueMinor  Int
  amountPaidMinor Int          @default(0)
  currency        String
  /// draft | open | paid | void | uncollectible (espelho do Stripe)
  status          String
  hostedInvoiceUrl String?
  periodStart     DateTime?
  periodEnd       DateTime?
  paidAt          DateTime?
  createdAt       DateTime     @default(now())

  payments Payment[]

  @@index([organizationId, createdAt(sort: Desc)])
}

enum CreditEntryType {
  PURCHASE
  PROMOTION
  SUBSCRIPTION
  USAGE
  REFUND
  MANUAL
  REVERSAL
}

/// Carteira de créditos como LEDGER imutável — o saldo é sempre derivado
/// da soma das entradas, nunca armazenado.
model CreditLedgerEntry {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Positivo = crédito; negativo = débito (minor units)
  amountMinor    Int
  currency       String          @default("BRL")
  type           CreditEntryType
  reason         String
  /// Origem (ex.: stripe:invoice_id, admin:user_id, promo:code)
  source         String?
  actorUserId    String?
  metadata       Json?
  createdAt      DateTime        @default(now())

  @@index([organizationId, createdAt(sort: Desc)])
}

// ============================================================
// Custos de provider: ESTIMATED (projeção) NUNCA se mistura com ACTUAL
// ============================================================

enum CostKind {
  ESTIMATED
  ACTUAL
}

model ProviderCost {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  provider       String
  kind           CostKind
  amountMinor    Int
  currency       String        @default("USD")
  periodStart    DateTime
  periodEnd      DateTime
  /// De onde veio (ex.: sync:cloudflare-api, builtin:local-zero-cost)
  source         String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId, kind, periodStart])
  @@index([projectId, kind])
}

// ============================================================
// Webhooks: dedup por (provider, eventId), retry e idempotência
// ============================================================

enum WebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  SKIPPED
}

model WebhookEvent {
  id          String        @id @default(cuid())
  provider    String
  eventId     String
  eventType   String
  status      WebhookStatus @default(RECEIVED)
  attempts    Int           @default(0)
  payload     Json
  error       String?
  receivedAt  DateTime      @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
  @@index([status, receivedAt])
}

// ============================================================
// Aquisição (first-touch) e configuração operacional
// ============================================================

model Acquisition {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  referrer       String?
  landingPage    String?
  createdAt      DateTime @default(now())

  @@index([utmSource, utmCampaign])
}

/// Configuração operacional gerenciável pelo admin (fx rate, feature flags,
/// maintenance, domínios reservados) — nunca secrets.
model AppConfig {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// ============================================================
// Notificações (sink desacoplado; envio de email é adapter futuro)
// ============================================================

model Notification {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  type           String
  title          String
  body           String?
  channel        String        @default("in_app")
  /// pending | sent | failed
  status         String        @default("pending")
  error          String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  sentAt         DateTime?

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([status])
}
