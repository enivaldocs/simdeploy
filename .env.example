# --- Banco de dados (PostgreSQL) ---
DATABASE_URL=postgresql://user@localhost:5432/autocloud_dev

# --- Aplicação ---
# URL pública do dashboard/API (usada em OAuth callbacks e URLs de deployment)
APP_URL=http://localhost:3000

# Segredo para assinar cookies de sessão (gerar: openssl rand -hex 32)
AUTH_SECRET=

# Chave AES-256-GCM para criptografar environment variables de projetos
# (gerar: openssl rand -hex 32 — 64 hex chars = 32 bytes)
ENCRYPTION_KEY=

# --- GitHub OAuth (opcional em dev; obrigatório para login GitHub) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Cloudflare (opcional; necessário apenas para o provider cloudflare) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
